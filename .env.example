# ============================================================================
# GoldRose environment variables (design doc §13)
#
# Every variable is OPTIONAL for local development: with none set, the app
# runs fully self-contained — local file database (.data/db.json), mock
# checkout (no money moves), and order emails logged to the console.
# ============================================================================

# --- Supabase (OQ-4: created by the owner; see docs/BUILD-REPORT.md checklist)
# With these unset, the local file adapter is used instead.
NEXT_PUBLIC_SUPABASE_URL=        # Supabase project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # public key — can only read the safe catalog view
SUPABASE_SERVICE_ROLE_KEY=       # SERVER ONLY, full DB access — mark sensitive in Vercel

# --- PayPal (OQ-1 working assumption; SANDBOX ONLY until launch)
# With these unset, checkout runs in mock mode (full click-through, no money).
PAYPAL_ENV=sandbox               # sandbox | live (live is an owner-only switch)
PAYPAL_CLIENT_ID=                # PayPal Developer Dashboard app (matching env)
PAYPAL_SECRET=                   # SERVER ONLY
PAYPAL_WEBHOOK_ID=               # for webhook signature verification
NEXT_PUBLIC_PAYPAL_CLIENT_ID=    # same client id, exposed for the JS SDK buttons

# --- Email (optional)
RESEND_API_KEY=                  # unset = order emails are logged to the console

# --- Admin login fallback (ignored once Supabase is configured)
# TESTING PHASE: with this unset (and no Supabase), the admin needs NO login
# at all — open access, everyone acts as the owner. Set it to require a
# password again; configure Supabase for full real auth. Until Supabase
# exists, production data is demo-only (in-memory).
ADMIN_DEV_PASSWORD=

# Public base URL of this storefront, used in emails / metadata / redirects.
# Defaults to http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
