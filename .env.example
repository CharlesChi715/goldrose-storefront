# Shopify integration mode.
# Use "mock" until the Shopify store, products, and Storefront API token exist.
SHOPIFY_MODE=mock

# Example: aurea-store.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Public Storefront API token from Shopify admin.
# Do not put Admin API tokens here.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Keep this pinned deliberately when wiring the real Shopify Storefront API.
SHOPIFY_STOREFRONT_API_VERSION=2026-04

# Used only in mock mode.
SHOPIFY_MOCK_CHECKOUT_URL=https://aurea.example/mock-checkout
