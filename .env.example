# ============================================================================
# ELDREVE environment variables (design doc §13)
#
# NOTE: the brand is ELDREVE (DQ-34 answered 2026-08-03); the repo-wide rename
# landed 2026-08-05 (AI-021). The lowercase `goldrose-*` strings that remain in
# the codebase are storage keys and the Vercel host, deliberately kept.
#
# Every variable is OPTIONAL for local development: with none set, the app
# runs fully self-contained — local file database (.data/db.json), mock
# checkout (no money moves), and order emails logged to the console.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS FILE — one question decides everything about a credential:
#
#     WHO READS IT AT RUNTIME, AND ON WHICH MACHINE?
#
# Not who issued it, and not which product it belongs to. A credential belongs
# wherever the CALLER runs. There are five authenticated links in the system,
# and every variable below serves exactly one of them:
#
#                            ┌───────────────────────────────┐
#                            │             RESEND            │
#                            │         (mail sender)         │──> customer
#                            └───▲───────────────────────▲───┘    inbox
#                                │ (4)                   │ (5)
#                                │                       │
#    ┌───────────┐       ┌───────┬───────┐       ┌───────┬───────┐
#    │  BROWSER  │──(1)─>│     VERCEL    │──(3)─>│    SUPABASE   │
#    │  visitor  │       │    our code   │       │  auth + data  │
#    └─────┬─────┘       └───────────────┘       └───────┬───────┘
#          │                                             │
#          └─────────────────────(2)─────────────────────┘
#
#    BROWSER is untrusted — everything it holds is world-readable.
#    VERCEL and SUPABASE are servers, and may hold secrets.
#
#  ┌──────────────────────┬────────────────────────┬───────────────────────────┐
#  │ Link                 │ Event (trigger)        │ Credential (env var)      │
#  ├──────────────────────┼────────────────────────┼───────────────────────────┤
#  │ (1) browser→Vercel   │ page loads, form posts │ session cookie (no var)   │
#  │ (2) browser→Supabase │ sign-in; JWT scopes it │ NEXT_PUBLIC_SUPABASE_*    │
#  │ (3) Vercel→Supabase  │ server reads/writes DB │ SUPABASE_SERVICE_ROLE_KEY │
#  │ (4) Vercel→Resend    │ order + shipping mail  │ RESEND_API_KEY            │
#  │ (5) Supabase→Resend  │ sign-in code + link    │ RESEND_SMTP_PASSWORD ⚠    │
#  └──────────────────────┴────────────────────────┴───────────────────────────┘
#
#  Protocols: (1)(2)(3)(4) are HTTPS; (5) is SMTP on port 465. RESEND is
#  reached TWICE — by us over REST, by Supabase over SMTP — which is why it
#  needs two separately-revocable keys.
#
#  ⚠ (5) is the only link with OUR CODE AT NEITHER END, so its key must never
#    be added to Vercel: Vercel is not a participant in that conversation.
#
#  ⚠ NEXT_PUBLIC_* is compiled into the JavaScript bundle at build time and
#    shipped to every visitor, so those values are PUBLIC BY CONSTRUCTION.
#    Never put a secret behind that prefix. The anon key is safe there only
#    because it grants nothing by itself: Row Level Security, not the key,
#    decides what any request may do — judged against the visitor's JWT.
# ---------------------------------------------------------------------------
# ============================================================================

# --- Supabase (hosted project is live; state lives in SUMMARY.md)
# With these unset, the local file adapter is used instead — but since
# 2026-08-07 `npm run dev` REFUSES to start that way (scripts/require-hosted-dev
# .mjs), because a dev server backed by seed data looks real and is not. The
# test suite still runs in local mode; it blanks these itself.
# LINKS: browser → Supabase (the two NEXT_PUBLIC_ values, shipped to visitors)
#        Vercel  → Supabase (the service-role key, server-side only)
NEXT_PUBLIC_SUPABASE_URL=        # project URL; public by construction
# PUBLIC — every visitor holds this. Safe only because Row Level Security,
# not the key, decides what any request may read or write.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — BYPASSES RLS, full database access. Never NEXT_PUBLIC_,
# never shipped to the browser. Mark it sensitive in Vercel.
SUPABASE_SERVICE_ROLE_KEY=
# Deliberately wake the sleeping local file adapter for a dev server — offline
# work, or a hosted outage. Never set this in Vercel. Unset by default so that
# forgetting to configure Supabase is an error, not a silent fake shop.
ALLOW_LOCAL_MODE=                # 1 = let `npm run dev` use .data/db.json

# --- PayPal (OQ-1 working assumption; SANDBOX ONLY until launch)
# With these unset, checkout runs in mock mode (full click-through, no money).
PAYPAL_ENV=sandbox               # sandbox | live (live is an owner-only switch)
PAYPAL_CLIENT_ID=                # PayPal Developer Dashboard app (matching env)
PAYPAL_SECRET=                   # SERVER ONLY
PAYPAL_WEBHOOK_ID=               # for webhook signature verification
NEXT_PUBLIC_PAYPAL_CLIENT_ID=    # same client id, exposed for the JS SDK buttons

# --- Skip payment (TESTING ONLY — must be unset/0 before launch)
# 1 = /checkout hides the card form and every payment button and shows a single
# "Place order" button that records the order immediately (source='mock', test
# badge, no money). Overrides PayPal even when its keys are set. The real
# payment code is untouched — unset this and checkout works exactly as before.
CHECKOUT_SKIP_PAYMENT=

# --- Email — ONE service, TWO links, TWO keys (see the header diagram)
# Grouped by ISSUER (Resend) so there is one place to look when revoking, with
# the reader named on each line. Both are Resend "sending" keys; they differ
# only in who holds them and which protocol they are spoken over.

# LINK: Vercel → Resend, over HTTPS REST with a Bearer token.
# READ BY OUR CODE (lib/email.ts) for order/shipping/owner mail. Unset = the
# message is logged to the server console and NOT sent — deliberately silent,
# so a mail outage can never fail a checkout. Belongs in Vercel Production.
RESEND_API_KEY=
# Display name + address, e.g. ELDREVE <orders@eldreve.com>. The display name
# must match the one Supabase sends auth mail under — same inbox, one brand.
# Defaults to onboarding@resend.dev when unset.
RESEND_FROM=

# LINK: Supabase → Resend, over SMTP (host smtp.resend.com, port 465, username
# the literal "resend", this value as the PASSWORD; sender noreply@eldreve.com
# / "ELDREVE"). Sends the customer sign-in + confirmation mail. LIVE 2026-08-03.
#
# ⚠️ NOT read by our code, and MUST NOT be added to Vercel — our code is at
# neither end of this link. Supabase already holds it; this line exists purely
# as the record of which key that is. Custom SMTP is also what unlocks
# Supabase's email templates at all (the free tier refuses template edits
# while its built-in sender is in use) and lifted the cap to 30 mails/hour.
RESEND_SMTP_PASSWORD=

# --- Admin login fallback (IGNORED — Supabase is configured)
# Only matters in local file mode: with this unset and no Supabase, the admin
# needs NO login at all — open access, everyone acts as the owner. Set it to
# require a password locally. Hosted admin auth is real Supabase auth, so this
# variable does nothing in production and is deliberately absent from Vercel.
ADMIN_DEV_PASSWORD=

# Public base URL of this storefront — canonical URLs, OG images, sitemap,
# and redirect targets. Production is https://eldreve.com (set in Vercel);
# leave it as localhost here. It only takes effect on a fresh production
# build, since NEXT_PUBLIC_* is baked in at build time — changing it in the
# dashboard does nothing until the next deploy.
#
# ⚠️ Not the same setting as Supabase's own Site URL, which is what the
# emailed sign-in link resolves against, and which the passkey RP ID is
# pinned to. Changing THAT one invalidates every existing passkey.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Figma design-file access for the figma-sync skill (delivery imports).
# Token needs file_content:read; revoke after design-import work ends.
FIGMA_TOKEN=
FIGMA_FILE_KEY=
