# Shopify integration mode.
# Use "mock" until the Shopify store, products, and Storefront API token exist.
SHOPIFY_MODE=mock

# Example: aurea-store.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Public Storefront API token from Shopify admin.
# Do not put Admin API tokens here.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Keep this pinned deliberately when wiring the real Shopify Storefront API.
SHOPIFY_STOREFRONT_API_VERSION=2026-04

# Used only in mock mode.
SHOPIFY_MOCK_CHECKOUT_URL=https://aurea.example/mock-checkout

# Public base URL of this storefront, used to build checkout redirect URLs.
# Defaults to http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Live checkout via Shopify cart permalink (no Storefront API token needed).
# When set, the storefront's checkout / Shop Pay / PayPal buttons hand the cart
# off to Shopify's hosted checkout (where PayPal is enabled) instead of the
# local mock flow. Set to your myshopify domain, e.g. goldrose-9372.myshopify.com
# Leave empty to use local mock checkout.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=

# Shop Pay, credit card, and PayPal are all served by Shopify's hosted checkout
# in live mode (Shop Pay and PayPal as accelerated wallets, card via Shopify
# Payments). There are no separate card/PayPal API keys to set here — enable the
# wallets inside Shopify Payments. See docs/checkout.md.
